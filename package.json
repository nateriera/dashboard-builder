{
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@observablehq/plot": "^0.6.17",
    "d3-dsv": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-shape": "^3.2.0",
    "gridstack": "^13.1.0",
    "htl": "^0.3.1",
    "idb": "^8.0.3",
    "topojson-client": "^3.1.0"
  },
  "description": "Free, open-source drag-and-drop dashboard composer. Pick chart types from a palette, drop them onto a grid, bind data, and export a self-contained HTML dashboard \u2014 no subscription, no server, no account.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Nate Riera",
  "repository": {
    "type": "git",
    "url": "https://github.com/nateriera/dashboard-builder.git"
  },
  "homepage": "https://github.com/nateriera/dashboard-builder#readme",
  "bugs": {
    "url": "https://github.com/nateriera/dashboard-builder/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "puppeteer-core": "^25.12.0",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "name": "dashboard-builder",
  "scripts": {
    "build": "vite build --config vite.export.config.js --configLoader runner && vite build --configLoader runner",
    "dev": "vite --configLoader runner",
    "preview": "vite preview",
    "build:export-template": "vite build --config vite.export.config.js --configLoader runner",
    "test": "node --no-warnings --loader ./tests/json-loader.mjs tests/render-sweep.mjs && node --no-warnings --loader ./tests/json-loader.mjs --test tests/remediation.test.mjs",
    "predev": "npm run build:export-template",
    "test:browser": "playwright test",
    "shots": "npm run build && node scripts/screenshots.mjs"
  },
  "type": "module"
}
